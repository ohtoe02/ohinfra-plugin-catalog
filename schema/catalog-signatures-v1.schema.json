{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ohinfra:catalog-signatures:v1",
  "title": "ohinfra catalog signature envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signatures"],
  "properties": {
    "schema_version": {"const": "1"},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "algorithm", "value"],
        "properties": {
          "key_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
          "algorithm": {"const": "ed25519"},
          "value": {"type": "string", "contentEncoding": "base64"}
        }
      }
    }
  }
}
